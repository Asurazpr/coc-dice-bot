# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=

# Optional: a development server ID for instant slash-command sync.
# Leave empty in production (commands are then registered globally).
DISCORD_GUILD_ID=

# Optional: database location (default: data/coc_bot.sqlite3)
COC_DB_PATH=

# Optional: dashboard scaffold
COC_DASH_HOST=127.0.0.1
COC_DASH_PORT=8000

# Optional: built-in occupation catalogue (JSON). Default: data/occupations/occupations.json.
# Set to "none" to run with homebrew occupations only. See docs/OCCUPATIONS.md §2.
COC_OCCUPATIONS_PATH=
